# Copy to .env (git ignores .env) and fill in. Never commit real keys.
GEMINI_API_KEY=paste-your-key-here
SMARTSTUDY_PROVIDER=gemini
SMARTSTUDY_MODEL=gemini-3.1-flash-lite
# Public deployment limits (optional)
SMARTSTUDY_MAX_CHARS=6000
SMARTSTUDY_MAX_QUESTIONS=8
# Optional: other models to try if the main one is busy or over quota (comma separated)
# SMARTSTUDY_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview
